node_modules/
.DS_Store
.worktrees/
coverage/
.harmony-task.json

# B-992: the PreToolUse hook's local gate-evidence markers — best-effort caches written by
# `harmony gates run <extension-point>`, never committed. .harmony/project.yml ITSELF stays tracked.
.harmony/.gate-evidence/

# B-1009: the notify subscription sync's hash cache — a local, best-effort record of the last
# declaration synced to the board, written by `harmony gates run`. Never committed; deleting it
# costs at most one redundant (idempotent) sync.
.harmony/.notify-sync.json

# B-1007: `main` is SOURCE ONLY. The built bundle is GENERATED and committed on the `staging`
# branch by scripts/generate-staging.sh (and `prod` fast-forwards from there), so `dist/` must not
# be tracked here — it was one of the two files every plugin PR used to collide on. Note that
# .gitignore is shared across branches, which is why the generation script stages it with
# `git add -f`. scripts/check-generated-artifacts.sh is the PR gate that keeps `main` clean.
dist/

# B-1036: the clarify-replay eval's label-fetch script (evals/clarify-replay/scripts/fetch-labels.mjs)
# writes the ratified clarify labels it reads from the PRODUCTION board here. Never committed — the
# labels must be pulled fresh at hand-pass time (a committed copy would drift from the board), and the
# script is read-only against Supabase, so nothing here is ever the record of anything. See
# evals/clarify-replay/RUNBOOK.md.
evals/clarify-replay/labels/

# B-1036 (same suite): `claude plugin eval`'s own default output — aggregate-result.json /
# --json / --report — lands under evals/clarify-replay/results/ by default. Confirmed live during
# this build's zero-cost dry run: it writes there even with no --output-dir override. Hand-pass
# output, never suite source; never committed. See RUNBOOK.md step 6.
evals/clarify-replay/results/

# B-1036 (same suite): the per-case LLM judge, generated by fetch-labels.mjs with the ratified
# production label embedded in its rubric. Never committed — labels are product-decision content.
evals/clarify-replay/cases/*/graders/judge.md

# B-1037 (same suite, CI wiring): fixture-export.mjs's read-only per-ticket exports of FX board
# state — used by the hand-authored read mocks' {{file:fixtures/...}} substitutions. Derived board
# content, regenerated by a founder/orchestrator run against FX; never committed (mirrors labels/
# above — a committed copy would drift from the fixture board and is never the record of anything).
evals/clarify-replay/mocks/plugin_harmony-plugin_harmony/fixtures/*.json

# B-1037: the two judge-calibration control cases' rendered-fresh-brief fixtures (one verbatim copy
# of a ratified label's content for the positive control, one boundary-flipped copy for the
# negative control) — generated by the same founder/orchestrator run (fetch-labels.mjs --controls)
# from real production label content, so they are gitignored exactly like every other case's
# graders/judge.md below.
evals/clarify-replay/cases/ctrl-*/fixtures/fresh-brief.md

# B-1037 (same suite): the two control cases' own weight-0 reasoning-grader rubric, generated
# alongside judge.md by the same script — label-bearing, same gitignore discipline.
evals/clarify-replay/cases/*/graders/judge-reasoning.md
