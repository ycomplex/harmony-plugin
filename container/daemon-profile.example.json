{
  "launch": "bash \"$HARMONY_PLUGIN_DIR/container/docker-worker-launch.sh\" {conduction_id} {ticket} '{run_config_json}' '{model}' '{worker_image}'",
  "reap": "bash \"$HARMONY_PLUGIN_DIR/container/docker-worker-reap.sh\" {conduction_id} {ticket}",
  "probe": "docker ps --filter name=harmony-worker-{conduction_id} --filter status=running --quiet | grep -q .",
  "maxConcurrentWorkers": 3,
  "agents": [
    "claude-code",
    "codex"
  ],
  "required_tools": {
    "launch": [
      "bash",
      "node",
      "docker"
    ],
    "reap": [
      "docker"
    ],
    "probe": [
      "docker"
    ]
  },
  "requires_app_mint": true,
  "schema_version": 1
}
