<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ==========================================================================================================
     DEPRECATED (B-1173). The ticket-disk sweep now runs in-cluster as the `harmony-sweep` CronJob
     (container/conductor/k8s/cronjob-sweep.yaml, every 6 hours, namespace harmony-conductor). Do NOT install this
     file on a new host.

     REMOVAL IS A FOUNDER STEP, AND ONLY AFTER THE CronJob HAS RUN ONCE SUCCESSFULLY:
         trigger the CronJob once by hand (the exact command is in container/conductor/k8s/cronjob-sweep.yaml,
         under RETIREMENT ORDER) and read the Job's log: expect a "sweep summary:" line and a Complete Job.
         (A plist comment cannot contain a double hyphen, so the command is not repeated here.)
     Then, on the Mac mini:  launchctl bootout gui/$UID/com.ycomplex.harmony-sweep  and delete this plist from
     ~/Library/LaunchAgents/. Until the first successful CronJob run both exist; the sweep is idempotent, so the
     overlap is harmless. This file stays in the repo until that has happened.
     ========================================================================================================== -->
<!-- B-1164: launchd schedule for the GKE ticket-disk sweep (container/gke/sweep-ticket-disks.sh).

     Runs every 6 hours (StartInterval 21600 seconds) on the conductor host. It deletes the per-ticket disk
     of every Verified / Cancelled / archived ticket and of every ticket taken away from the conductor
     more than 24 hours ago; it never deletes a disk a live pod mounts, and fails closed (exit 3) when a
     ticket's state cannot be read.

     Install: replace the three REPLACE-ME placeholders below, copy to ~/Library/LaunchAgents/, then:
         launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.ycomplex.harmony-sweep.plist
     Placeholders:
       /REPLACE-ME/path/to/harmony-plugin   absolute path of the plugin checkout (appears in the script
                                            path, WorkingDirectory and HARMONY_PLUGIN_DIR; the sweep reads
                                            ticket state via $HARMONY_PLUGIN_DIR/dist/bin/harmony.js)
       /Users/REPLACE-ME/Library/Logs       where the sweep's output goes (stdout and stderr, one file)
       PATH                                 must contain kubectl, gke-gcloud-auth-plugin and node;
                                            launchd does not read your shell PATH (a Homebrew gcloud
                                            keeps the auth plugin in /opt/homebrew/share/google-cloud-sdk/bin)
     The sweep loads ~/.harmony/conductor.env (else the legacy daemon.env) itself (HARMONY_API_TOKEN for the ticket-state reads).
     The sweep uses the CURRENT kubeconfig context of the user it runs as. No credential lives here. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ycomplex.harmony-sweep</string>

    <key>ProgramArguments</key>
    <array>
        <string>bash</string>
        <string>container/gke/sweep-ticket-disks.sh</string>
        <string>--namespace</string>
        <string>harmony-legs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/REPLACE-ME/path/to/harmony-plugin</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HARMONY_PLUGIN_DIR</key>
        <string>/REPLACE-ME/path/to/harmony-plugin</string>
        <key>PATH</key>
        <string>/opt/homebrew/share/google-cloud-sdk/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartInterval</key>
    <integer>21600</integer>
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/REPLACE-ME/Library/Logs/harmony-sweep.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/REPLACE-ME/Library/Logs/harmony-sweep.log</string>
</dict>
</plist>
