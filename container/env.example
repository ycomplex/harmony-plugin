# B-694 build-environment config — copy to a private file (e.g. ~/.harmony-container.env,
# NEVER committed) and pass with: docker run --env-file <file>
# Everything machine- or environment-specific enters HERE; nothing is baked
# into the image and nothing is hand-edited inside the container.

# --- READ PLANE -------------------------------------------------------------
# Which Harmony board / Supabase project the worker's MCP + CLI talk to.
# NOT deploy targeting: deploys happen in CI from GitHub secrets after a
# merge. HARMONY_TARGET=staging does NOT deploy anything to staging — the
# container only ever pushes a branch and opens a PR.
#   prod    — the real board (default; where tickets live)
#   staging — B-488-style plugin-change dogfood only, a SUPPORTED configuration (B-800), not an
#             undocumented workaround — the daemon host's ~/.harmony/deployment.json
#             launcher.supabase triple (url/anon_key/api_token) is the source of truth for this
#             target; container/provision.sh's launcher.supabase.url lookup takes precedence over
#             the hardcoded URL map below when a deployment config is present.
#   custom  — also set HARMONY_SUPABASE_URL (+ anon key)
HARMONY_TARGET=prod

# Board API token for the chosen target.
HARMONY_API_TOKEN=

# Anon key for the chosen target (Supabase dashboard > Project Settings > API
# keys). Required for staging/custom; optional for prod (baked default).
#HARMONY_SUPABASE_ANON_KEY=

# custom target only:
#HARMONY_SUPABASE_URL=

# --- GIT --------------------------------------------------------------------
# GitHub token able to clone/push ycomplex repos, AND the identity `gh` opens
# PRs as. A founder PAT here means daemon PRs are FOUNDER-authored, which lands
# them in the branch-protection bypass lane and leaves the B-695 merge floor
# inert (B-732). Interactive dogfood runs legitimately use a founder PAT.
#
# For DAEMON worker runs this key is filled in automatically: the launch profile
# runs scripts/mint-installation-token.mjs, which mints a ~1h harmony-daemon App
# installation token and writes a per-run env-file (mode 0600) with GIT_TOKEN
# set to it — so worker PRs are bot-authored and genuinely need your review.
# Set the three App inputs below on the LAUNCHER (the daemon host), not here.
GIT_TOKEN=
GIT_USER_NAME=
GIT_USER_EMAIL=

# --- HARMONY-DAEMON APP (launcher host only — B-732) ------------------------
# Read by scripts/mint-installation-token.mjs when it mints the per-run token.
# These never enter the container; only the minted GIT_TOKEN does.
# The App must be installed on EVERY repo the container clones — harmony-web,
# harmony-plugin AND harmony-workspace (its installation is repo-selected, so a
# missing repo fails the clone).
#
# B-800: these three are documented per-deployment facts — the source of truth going forward is
# launcher.github_app.{app_id,installation_id,private_key_path} in this launcher host's
# ~/.harmony/deployment.json (src/config/deployment-config.ts). mint-installation-token.mjs stays a
# zero-dependency script and still reads these env vars directly (see its header comment); set them
# here FROM your deployment config's launcher.github_app section, not the other way around.
#HARMONY_APP_ID=
#HARMONY_APP_INSTALLATION_ID=
# Prefer the PATH form — a PEM in an env var has to survive newline escaping.
#HARMONY_APP_PRIVATE_KEY_PATH=/absolute/path/to/harmony-daemon.private-key.pem
#HARMONY_APP_PRIVATE_KEY=

# Repos/refs to clone at start (defaults shown).
#WEB_REF=main
#WORKSPACE_REF=main

# B-803: ONE var decides which plugin ref this worker runs AND whether running it ahead of
# prod is acknowledged — collapses the old PLUGIN_REF + HARMONY_ACK_PLUGIN_AHEAD_OF_PROD pair
# (which could be set inconsistently, and the ack half was unreachable on the cloud profile:
# Cloud Run's --env-vars-file REPLACES the job's literal env, and the mint/launch wrapper never
# forwarded PLUGIN_REF at all). Reachable identically on every launch profile (local + cloud).
# Three values:
#   prod        — run the prod plugin ref (the safe default posture)
#   ack:<ref>   — run <ref> (e.g. ack:main) with the ahead-of-prod risk explicitly acknowledged;
#                 echoed unconditionally in the startup banner so every transcript/log records
#                 the exemption (the B-383 invariant — plugin `prod` must never read schema a
#                 `prod` board lacks)
#   <ref>       — a bare ref with no "ack:" prefix (ref != "prod"): NOT acknowledged. headless
#                 mode fails closed if HARMONY_TARGET resolves to `prod`.
# Defaults to "main" when unset (the daemon's historical default posture: fixes reach workers
# within minutes, no promote step). Pin HARMONY_PLUGIN_POSTURE=prod to stay fail-closed.
#HARMONY_PLUGIN_POSTURE=main

# --- AGENT LAYER ONLY -------------------------------------------------------
# PRIMARY headless auth: a long-lived Claude Code OAuth token (~1 year),
# minted on any machine with your Max subscription via: claude setup-token
# This keeps headless `claude -p` runs on subscription auth.
CLAUDE_CODE_OAUTH_TOKEN=

# FALLBACK ONLY — an Anthropic API key OVERRIDES subscription auth and bills
# per-token. Leave commented out unless you explicitly want API billing; a
# set-but-empty value would shadow the OAuth token (provision.sh unsets empty
# values defensively, same class as the anon-key guard).
#ANTHROPIC_API_KEY=

# Headless permission envelope (default set in the agent image; the container
# is the sandbox that makes the broad grant safe).
#CLAUDE_HEADLESS_FLAGS=--dangerously-skip-permissions
